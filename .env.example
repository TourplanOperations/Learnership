# Copy to .env for local development. In Render, set these as environment variables.

# Public URL of the portal (used in email links), e.g. https://learnership.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Intake and application window (SAST, UTC+2)
INTAKE_YEAR=2027
APPLICATIONS_OPEN_AT=2026-11-01T00:00:00+02:00
APPLICATIONS_CLOSE_AT=2027-01-08T23:59:59+02:00

# Supabase (Project Settings > API). Leave blank locally to store data in ./local-data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=learnership-documents

# Email. Leave all of these blank locally to write emails to ./local-data/outbox.
#
# Microsoft 365 (recommended): Microsoft Graph with an Entra ID app registration that has the
# Mail.Send application permission, limited to the sending mailbox. Modern authentication only;
# no mailbox password. GRAPH_SENDER defaults to the address in MAIL_FROM.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
#
# Alternative: SMTP, used only when the GRAPH_* settings are blank.
# Resend:   smtp.resend.com,   port 587, user "resend", pass = API key.
# SendGrid: smtp.sendgrid.net, port 587, user "apikey", pass = API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tourplan Learnership <learnership.applications@tourplan.com>"
TEAM_INBOX=Learnership.Applications@tourplan.com
SEND_APPLICANT_CONFIRMATION=true

# Admin review page (/admin)
ADMIN_PASSWORD=
# Long random string, e.g. output of: openssl rand -base64 48
SESSION_SECRET=

MAX_FILE_MB=10
